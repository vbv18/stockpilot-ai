# Existing Server Environment Variables
NODE_ENV=development
PORT=8000
ALLOWED_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/stockpilot
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=example_token

# New StockPilot Server Infrastructure Variables
# Logging level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# MongoDB configuration
MONGODB_URI=mongodb://localhost:27017/stockpilot
MONGODB_DB_NAME=stockpilot

# Python stats service connection
STATS_SERVICE_URL=http://localhost:8000
STATS_SERVICE_KEY=change-me-to-a-long-random-string-min-16
STATS_TIMEOUT_MS=900000

# File storage configuration
STORAGE_DIR=./storage
UPLOAD_MAX_BYTES=62914560
UPLOAD_MAX_ROWS=600000

# Background job concurrency
JOB_CONCURRENCY=2

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=stockpilot_session_artifacts

# AI LLM Provider (optional: gemini, openai, anthropic)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048

# AI Embedding Provider (optional: gemini, openai)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=

# Rate limits
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_GENERAL_PER_MINUTE=300
